@rendermode InteractiveServer
@using System.ComponentModel
@using CSIDE.Data.Models.Infrastructure
@using CSIDE.Data.Services
@using CSIDE.Web.Extensions
@using ClosedXML.Excel
@inject NavigationManager navigationManager
@inject IInfrastructureService infrastructureService
@inject IJSRuntime JS

@implements IAsyncDisposable

<p><a href="Infrastructure#search-form">@localizer["Search Again Label"]</a></p>

    <button type="button" class="btn btn-outline-secondary" @onclick="OnExport" disabled="@IsExporting">
    @if (IsExporting)
    {
        <Spinner Size="SpinnerSize.Small" class="me-3"/>
    }
    else
    {
        <Icon Name="IconName.Download" class="me-3" />
    }
    @localizer["Download Label"]
</button>

<Grid TItem="InfrastructureItem"
        Class="table table-hover table-bordered table-striped mt-2"
        DataProvider="InfrastructureItemsDataProvider"
        AllowFiltering="false"
        AllowPaging="true"
        PageSize="20"
        AllowSorting="true"
        AllowSelection="false"
        AllowRowClick="true"
        OnRowClick="OnRowClick"
        AutoHidePaging="false"
        Responsive="true">

    <GridColumns>
        <GridColumn TItem="InfrastructureItem" HeaderText="@localizer["Infrastructure ID Label"]" PropertyName="Id" SortKeySelector="item => item.Id" SortString="Id">
            <a href="Infrastructure/Details/@context.Id" @onclick:stopPropagation>@IDPrefixOptions.Value.Infrastructure@context.Id</a>
        </GridColumn>
        <GridColumn TItem="InfrastructureItem" HeaderText="@localizer["Parish Label"]" PropertyName="Parish" SortKeySelector="item => item.Parish != null ? item.Parish.Name : string.Empty" SortString="Parish">
            @context.Parish?.Name
        </GridColumn>
        <GridColumn TItem="InfrastructureItem" HeaderText="@localizer["Route ID Label"]" PropertyName="RouteId" SortKeySelector="item => item.RouteId" SortString="RouteId">
            @context.RouteId
        </GridColumn>
        <GridColumn TItem="InfrastructureItem" HeaderText="@localizer["Infrastructure Type Label"]" PropertyName="InfrastructureType" SortKeySelector="item => item.InfrastructureType != null ? item.InfrastructureType.Name : string.Empty" SortString="InfrastructureType">
            @context.InfrastructureType?.Name
        </GridColumn>

    </GridColumns>
    <GridTemplates>
        <GridEmptyDataTemplate TItem="InfrastructureItem">
            <div class="text-center text-muted">
                <span class="bi bi-inbox fs-2"></span>
                <div>
                    <p>@localizer["No Results Found Label"]</p>
                    <p><a href="Infrastructure#search-form">@localizer["Search Again Label"]</a></p>
                </div>
            </div>
        </GridEmptyDataTemplate>
    </GridTemplates>
</Grid>



@code {
    [Parameter]
    public string? RouteId { get; set; }
    [Parameter]
    public string[]? ParishIds { get; set; }
    [Parameter]
    public string? ParishId { get; set; }
    [Parameter]
    public string? MaintenanceTeamId { get; set; }
    [Parameter]
    public string? LoggedById { get; set; }
    [Parameter]
    public string? InfrastructureTypeId { get; set; }
    [Parameter]
    public DateOnly? InstallationDateFrom { get; set; }
    [Parameter]
    public DateOnly? InstallationDateTo { get; set; }

    private IJSObjectReference? _jsModule;
    private bool IsExporting;

    public async Task<GridDataProviderResult<InfrastructureItem>> InfrastructureItemsDataProvider(GridDataProviderRequest<InfrastructureItem> request)
    {
        //handle sorting
        string sortString = "";
        ListSortDirection sortDirection = ListSortDirection.Ascending;
        if (request.Sorting is not null && request.Sorting.Any())
        {
            // Note: Multi column sorting is not supported at this moment
            sortString = request.Sorting.FirstOrDefault()!.SortString;
            sortDirection = request.Sorting.FirstOrDefault()!.SortDirection == SortDirection.Ascending ? ListSortDirection.Ascending : ListSortDirection.Descending;
        }

        var result = await infrastructureService.GetInfrastructureItemBySearchParameters(
                RouteId,
                ParishIds,
                ParishId,
                MaintenanceTeamId,
                InfrastructureTypeId,
                InstallationDateFrom,
                InstallationDateTo,
                sortString,
                sortDirection,
                request.PageNumber,
                request.PageSize, request.CancellationToken);

        return await Task.FromResult(new GridDataProviderResult<InfrastructureItem> { Data = result.Results, TotalCount = result.TotalResults });
    }


    private void OnRowClick(GridRowEventArgs<InfrastructureItem> args) => navigationManager.NavigateTo($"Infrastructure/Details/{args.Item.Id}");

    private async Task OnExport()
    {
        IsExporting = true;

        try
        {
            _jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");

            var result = infrastructureService.GetDownloadableInfrastructureItemsBySearchParameters(
                RouteId,
                ParishIds,
                ParishId,
                MaintenanceTeamId,
                InfrastructureTypeId,
                InstallationDateFrom,
                InstallationDateTo
                );

            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Infrastructure Items Export");

            string[] headers =
            [
                localizer["Infrastructure ID Label"],
                localizer["Infrastructure Type Label"],
                localizer["Infrastructure Description Label"],
                localizer["Infrastructure Installation Date Label"],
                localizer["Infrastructure Height Label"],
                localizer["Infrastructure Width Label"],
                localizer["Infrastructure Length Label"],
                localizer["Easting Label"],
                localizer["Northing Label"],
                @localizer["Route ID Label"],
                @localizer["Parish Label"],
                @localizer["Maintenance Team Label"],
                localizer["Bridge Survey Beams Short Label"],
                localizer["Bridge Survey Decking Short Label"],
                localizer["Bridge Survey Handrail Short Label"],
                localizer["Bridge Survey Handrail Posts Short Label"],
                localizer["Bridge Survey Bank Seat Short Label"],
                localizer["Bridge Survey Anti Slip Short Label"],
                localizer["Bridge Survey Gates Short Label"],
                localizer["Bridge Survey Stiles Short Label"],
                localizer["Bridge Survey Ramps Short Label"],
                localizer["Bridge Survey Steps Short Label"],
                $"{localizer["Bridge Survey Condition Title"]} - {localizer["Bridge Survey Beams Short Label"]}",
                $"{localizer["Bridge Survey Condition Title"]} - {localizer["Bridge Survey Decking Short Label"]}",
                $"{localizer["Bridge Survey Condition Title"]} - {localizer["Bridge Survey Handrail Short Label"]}",
                $"{localizer["Bridge Survey Condition Title"]} - {localizer["Bridge Survey Handrail Posts Short Label"]}",
                $"{localizer["Bridge Survey Condition Title"]} - {localizer["Bridge Survey Bank Seat Short Label"]}",
                $"{localizer["Bridge Survey Repairs Title"]} - {localizer["Bridge Survey Overgrown Short Label"]}",
                $"{localizer["Bridge Survey Repairs Title"]} - {localizer["Bridge Survey Signs Of Bank Erosion Short Label"]}",
                $"{localizer["Bridge Survey Repairs Title"]} - {localizer["Bridge Survey Seriously Eroded Short Label"]}",
                $"{localizer["Bridge Survey Repairs Title"]} - {localizer["Bridge Survey High Usage Short Label"]}",
                $"{localizer["Bridge Survey Repairs Title"]} - {localizer["Bridge Survey Cover Boards In Place Short Label"]}"
            ];

            for (int i = 0; i < headers.Length; i++)
            {
                worksheet.Cell(1, i + 1).Value = headers[i];
            }

            int row = 2;
            await foreach (var infra in result)
            {
                worksheet.Cell(row, 1).Value = $"{IDPrefixOptions.Value.Infrastructure}{infra.Id}";
                worksheet.Cell(row, 2).Value = infra.InfrastructureTypeName;
                worksheet.Cell(row, 3).Value = infra.Description;
                var installationDateCell = worksheet.Cell(row, 4);
                if (infra.InstallationDate.HasValue)
                {
                    installationDateCell.Value = infra.InstallationDate.Value.ToDateTimeUnspecified();
                    installationDateCell.Style.DateFormat.Format = "dd/MM/yyyy";
                }
                else
                {
                    installationDateCell.Clear();
                }
                worksheet.Cell(row, 5).Value = infra.Height;
                worksheet.Cell(row, 6).Value = infra.Width;
                worksheet.Cell(row, 7).Value = infra.Length;
                worksheet.Cell(row, 8).Value = infra.Easting?.ToString("F2");
                worksheet.Cell(row, 9).Value = infra.Northing?.ToString("F2");
                worksheet.Cell(row, 10).Value = infra.RouteId;
                worksheet.Cell(row, 11).Value = infra.ParishName;
                worksheet.Cell(row, 12).Value = infra.MaintenanceTeamName;
                if (infra.InfrastructureTypeIsBridge)
                {
                    var beamValue = infra.BeamMaterialName ?? localizer["Not Provided Label"];
                    if (infra.BeamMaterialIsWood == true)
                    {
                        var beamDetails = new List<string>
                        {
                            $"{localizer["Bridge Num Timbers Short Label"]}: {infra.NumBeamTimbers}",
                            $"{localizer["Bridge Timbers Size Short Label"]}: {infra.BeamTimbersSize}"
                        };
                        beamValue = $"{beamValue}; {string.Join("; ", beamDetails.Where(detail => !string.IsNullOrWhiteSpace(detail)))}";
                    }
                    worksheet.Cell(row, 13).Value = beamValue;

                    var deckingValue = infra.DeckingMaterialName ?? localizer["Not Provided Label"];
                    if (infra.DeckingMaterialIsWood == true)
                    {
                        var deckingDetails = new List<string>
                        {
                            $"{localizer["Bridge Num Boards Short Label"]}: {infra.NumDeckingBoards}",
                            $"{localizer["Bridge Timbers Size Short Label"]}: {infra.DeckingBoardsSize}",
                            $"{localizer["Bridge Timbers Length Short Label"]}: {infra.DeckingBoardsLength} {localizer["Metres Label"]}"
                        };
                        deckingValue = $"{deckingValue}; {string.Join("; ", deckingDetails.Where(detail => !string.IsNullOrWhiteSpace(detail)))}";
                    }
                    worksheet.Cell(row, 14).Value = deckingValue;

                    var handrailValue = infra.HandrailMaterialName ?? localizer["Not Provided Label"];
                    if (infra.HandrailMaterialIsWood == true)
                    {
                        var handrailDetails = new List<string>
                        {
                            $"{localizer["Bridge Handrails In Place Short Label"]}: {infra.HandrailsInPlace.ToLocalizedDisplayString(localizer)}",
                            $"{localizer["Bridge Timbers Size Short Label"]}: {infra.HandrailTimbersSize}"
                        };
                        handrailValue = $"{handrailValue}; {string.Join("; ", handrailDetails.Where(detail => !string.IsNullOrWhiteSpace(detail)))}";
                    }
                    worksheet.Cell(row, 15).Value = handrailValue;

                    var handrailPostsValue = infra.HandrailPostsMaterialName ?? localizer["Not Provided Label"];
                    if (infra.HandrailPostsMaterialIsWood == true)
                    {
                        var handrailPostDetails = new List<string>
                        {
                            $"{localizer["Bridge Num Timbers Short Label"]}: {infra.NumHandrailPostsTimbers}",
                            $"{localizer["Bridge Timbers Size Short Label"]}: {infra.HandrailPostsTimbersSize}"
                        };
                        handrailPostsValue = $"{handrailPostsValue}; {string.Join("; ", handrailPostDetails.Where(detail => !string.IsNullOrWhiteSpace(detail)))}";
                    }
                    worksheet.Cell(row, 16).Value = handrailPostsValue;

                    worksheet.Cell(row, 17).Value = infra.BankSeatMaterialName ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 18).Value = infra.AntiSlipInstalled.ToLocalizedDisplayString(localizer) ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 19).Value = infra.GateInstalled.ToLocalizedDisplayString(localizer) ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 20).Value = infra.StileInstalled.ToLocalizedDisplayString(localizer) ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 21).Value = infra.RampInstalled.ToLocalizedDisplayString(localizer) ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 22).Value = infra.StepsInstalled.ToLocalizedDisplayString(localizer) ?? localizer["Not Provided Label"];

                    worksheet.Cell(row, 23).Value = infra.BeamConditionName ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 24).Value = infra.DeckingConditionName ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 25).Value = infra.HandrailConditionName ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 26).Value = infra.HandrailPostsConditionName ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 27).Value = infra.BankSeatConditionName ?? localizer["Not Provided Label"];

                    worksheet.Cell(row, 28).Value = infra.Overgrown.ToLocalizedDisplayString(localizer) ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 29).Value = infra.SignsOfBankErosion.ToLocalizedDisplayString(localizer) ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 30).Value = infra.SeriouslyEroded.ToLocalizedDisplayString(localizer) ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 31).Value = infra.HighUsage.ToLocalizedDisplayString(localizer) ?? localizer["Not Provided Label"];
                    worksheet.Cell(row, 32).Value = infra.CoverBoardsInPlace.ToLocalizedDisplayString(localizer) ?? localizer["Not Provided Label"];
                }
                row++;
            }
            
            var usedRange = worksheet.Range(1, 1, Math.Max(row - 1, 1), headers.Length);
            usedRange.CreateTable();


            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            stream.Position = 0;

            var fileName = $"infrastructure-{DateTime.UtcNow:yyyyMMdd-HHmmss}.xlsx";
            using var streamReference = new DotNetStreamReference(stream);
            await _jsModule.InvokeVoidAsync("downloadFileFromStream", fileName, streamReference);
        }
        finally
        {
            IsExporting = false;
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            if (_jsModule != null)
            {
                await _jsModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Ignore as it doesn't matter
        }
        finally
        {
            GC.SuppressFinalize(this);
        }
    }
}
