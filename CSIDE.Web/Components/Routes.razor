@using CSIDE.Web.Components.Pages
@using CSIDE.Web.Components.Pages.Account
@using CSIDE.Web.Components.Authorization
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <StepUpAccessGate RouteData="routeData"></StepUpAccessGate>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <NotFound />
        </LayoutView>
    </NotFound>
</Router>
