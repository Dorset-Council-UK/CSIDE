@attribute [AllowAnonymous]
@page "/account/login-failed"
@inject Microsoft.Extensions.Localization.IStringLocalizer<LoginFailed> localizer

<PageTitle>@localizer["Login failed"]</PageTitle>

<h3>@localizer["Login failed"]</h3>

<p>@localizer["We couldn't sign you in. Please try again, and if the issue continues contact an administrator or reset your password."]</p>
